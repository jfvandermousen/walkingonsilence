---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500 dark:text-slate-400">Works with the world</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <Icon class="size-8 md:size-12" name="solar:planet-bold" />
    <Icon class="size-8 md:size-12" name="solar:planet-2-bold" />
    <Icon class="size-8 md:size-12" name="solar:planet-3-bold" />
    <Icon class="size-8 md:size-12" name="solar:planet-4-bold" />
    <Icon class="size-8 md:size-12" name="solar:earth-bold" />
    <Icon class="size-8 md:size-12" name="solar:asteroid-bold" />

  </div>
</div>
