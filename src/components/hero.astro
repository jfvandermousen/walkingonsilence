---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
import Button from "@/components/ui/button.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Astronaut in the air"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      A man walking on silence
    </h1>
    <p class="text-lg mt-4 text-slate-600 dark:text-slate-300 max-w-xl">
      He let the Earth breathe without him, for the length of one orbit.<wbr /> Up
      there, the cities are only embers and the borders dissolve beneath the blue
      curve. Every heartbeat echoes inside the suit like a distant drum, and the
      astronaut learns, in that bright cold, that falling without end is still a
      way of flying.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="mailto:jf.vandermousen@gmail.com"
        class="flex gap-1 items-center justify-center"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxs-envelope" />

        Contact me
      </Link>
      <Button
        id="theme-toggle"
        type="button"
        size="lg"
        style="outline"
        class="flex gap-1 items-center justify-center">
        Try and guess what happens
      </Button>
    </div>
  </div>
</main>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
