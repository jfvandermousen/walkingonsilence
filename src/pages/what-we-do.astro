---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

const svgAttrs =
  'viewBox="0 0 200 150" preserveAspectRatio="xMidYMid meet" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"';

const storyboard = [
  {
    frame: "01",
    title: "Suit up",
    caption:
      "The crew seals into pressure suits and runs the pre-flight checklist with mission control.",
    svg: `<svg ${svgAttrs}>
      <path d="M38 150 Q38 108 70 98 L130 98 Q162 108 162 150" />
      <rect x="78" y="86" width="44" height="14" rx="4" />
      <circle cx="100" cy="54" r="38" />
      <path d="M74 50 Q100 30 126 50 Q126 76 100 82 Q74 76 74 50 Z" fill="currentColor" fill-opacity="0.08" />
      <line x1="138" y1="34" x2="152" y2="20" />
      <circle cx="152" cy="20" r="3" fill="currentColor" />
    </svg>`,
  },
  {
    frame: "02",
    title: "Ignition & ascent",
    caption:
      "Engines light, the clamps release and the rocket climbs to orbit in under nine minutes.",
    svg: `<svg ${svgAttrs}>
      <path d="M100 12 Q86 34 86 82 L86 100 L114 100 L114 82 Q114 34 100 12 Z" />
      <circle cx="100" cy="54" r="7" />
      <path d="M86 90 L70 110 L86 104 Z" />
      <path d="M114 90 L130 110 L114 104 Z" />
      <g class="text-orange-500">
        <path d="M90 102 Q100 134 110 102 Q106 118 100 122 Q94 118 90 102 Z" fill="currentColor" stroke="none" />
      </g>
      <circle cx="80" cy="130" r="12" />
      <circle cx="100" cy="137" r="14" />
      <circle cx="122" cy="130" r="12" />
      <path d="M40 28 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 z" fill="currentColor" stroke="none" />
      <path d="M162 44 l1.5 3.5 3.5 1.5 -3.5 1.5 -1.5 3.5 -1.5 -3.5 -3.5 -1.5 3.5 -1.5 z" fill="currentColor" stroke="none" />
    </svg>`,
  },
  {
    frame: "03",
    title: "Rendezvous & docking",
    caption:
      "A day of careful burns brings the spacecraft to the station for docking.",
    svg: `<svg ${svgAttrs}>
      <rect x="120" y="54" width="58" height="42" rx="8" />
      <rect x="150" y="8" width="34" height="30" />
      <line x1="167" y1="8" x2="167" y2="38" />
      <rect x="150" y="112" width="34" height="30" />
      <line x1="167" y1="112" x2="167" y2="142" />
      <line x1="150" y1="54" x2="150" y2="38" />
      <line x1="150" y1="96" x2="150" y2="112" />
      <rect x="108" y="67" width="12" height="16" />
      <path d="M58 58 Q38 75 58 92 L80 84 L80 66 Z" />
      <circle cx="60" cy="75" r="5" />
      <line x1="80" y1="75" x2="108" y2="75" stroke-dasharray="4 5" />
    </svg>`,
  },
  {
    frame: "04",
    title: "Science in microgravity",
    caption:
      "The crew runs experiments in microgravity, from crystal growth to medical tests.",
    svg: `<svg ${svgAttrs}>
      <g transform="rotate(-16 100 78)">
        <circle cx="100" cy="44" r="16" />
        <rect x="86" y="58" width="28" height="36" rx="11" />
        <path d="M86 64 L64 76" />
        <path d="M114 64 L136 58" />
        <path d="M92 94 L86 122" />
        <path d="M108 94 L116 122" />
      </g>
      <path d="M140 86 L140 102 L134 114 L154 114 L148 102 L148 86 Z" />
      <line x1="140" y1="86" x2="148" y2="86" />
      <circle cx="46" cy="40" r="4" />
      <circle cx="58" cy="28" r="2.5" />
      <circle cx="150" cy="44" r="3" />
    </svg>`,
  },
  {
    frame: "05",
    title: "Spacewalk",
    caption:
      "Tethered outside, the crew swaps batteries and repairs hardware in vacuum.",
    svg: `<svg ${svgAttrs}>
      <path d="M0 18 L66 18 L66 58 L28 58 L28 132 L0 132" />
      <rect x="66" y="26" width="42" height="24" />
      <line x1="87" y1="26" x2="87" y2="50" />
      <path d="M40 70 Q82 92 118 80" stroke-dasharray="2 6" />
      <circle cx="132" cy="68" r="14" />
      <rect x="120" y="80" width="24" height="30" rx="9" />
      <path d="M120 86 L102 80" />
      <path d="M144 86 L162 96" />
      <path d="M126 110 L120 134" />
      <path d="M138 110 L144 134" />
    </svg>`,
  },
  {
    frame: "06",
    title: "Re-entry & splashdown",
    caption:
      "Parachutes open, the capsule splashes down and the recovery ship moves in.",
    svg: `<svg ${svgAttrs}>
      <path d="M48 46 A30 30 0 0 1 108 46 Z" />
      <path d="M92 46 A30 30 0 0 1 152 46 Z" />
      <path d="M48 46 L96 92 M78 46 L96 92 M108 46 L96 92" />
      <path d="M92 46 L96 92 M122 46 L96 92 M152 46 L96 92" />
      <path d="M84 92 L108 92 L102 112 L90 112 Z" />
      <g class="text-sky-500">
        <path d="M0 122 q14 -10 28 0 t28 0 t28 0 t28 0 t28 0 t28 0 t28 0" />
        <path d="M0 134 q14 -10 28 0 t28 0 t28 0 t28 0 t28 0 t28 0 t28 0" />
      </g>
    </svg>`,
  },
];
---

<Layout title="What we do">
  <Container>
    <Sectionhead>
      <Fragment slot="title">What we do</Fragment>
      <Fragment slot="desc">A mission, frame by frame.</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">The mission storyboard</h2>
      <p class="text-lg leading-relaxed text-slate-500 mt-3">
        Every flight follows the same six beats, from the launch pad to the
        recovery ship.
      </p>
    </div>

    <ol
      class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 mx-auto max-w-5xl mt-12">
      {
        storyboard.map((panel) => (
          <li class="relative flex flex-col rounded-xl border border-gray-200 bg-white overflow-hidden transition hover:-translate-y-1 hover:shadow-xl">
            <span class="absolute top-3 left-3 z-10 flex items-center justify-center w-8 h-8 rounded-full bg-gray-900 text-white text-xs font-bold font-mono">
              {panel.frame}
            </span>

            <div
              class="h-44 flex items-center justify-center p-6 bg-gray-50 text-gray-800 border-b border-gray-200"
              set:html={panel.svg}
            />

            <div class="p-5">
              <h3 class="font-semibold text-base text-gray-800">
                {panel.title}
              </h3>
              <p class="text-slate-500 mt-1 text-sm leading-relaxed">
                {panel.caption}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</Layout>
